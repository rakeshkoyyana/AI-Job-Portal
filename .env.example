# Copy to .env — never commit it.
ANTHROPIC_API_KEY=
# Optional job-search API (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Job-alert email ingestion (LinkedIn/Indeed/Glassdoor/Handshake alerts). Use a Gmail APP PASSWORD, not your login password.
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
