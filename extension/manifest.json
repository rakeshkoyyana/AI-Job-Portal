{
  "manifest_version": 3,
  "name": "Hirewing",
  "version": "0.3.0",
  "description": "Hirewing auto-applies on LinkedIn Easy Apply, Indeed and company career sites using your tailored resumes. Runs in your own browser; talks only to your local Hirewing server.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hirewing",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "lib/mapper.js",
        "lib/dom.js",
        "lib/form.js",
        "lib/flow.js",
        "lib/core.js",
        "lib/page.js",
        "content/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": [
        "lib/mapper.js",
        "lib/dom.js",
        "lib/form.js",
        "lib/flow.js",
        "lib/core.js",
        "lib/page.js",
        "content/indeed.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.jobvite.com/*"
      ],
      "js": [
        "lib/mapper.js",
        "lib/dom.js",
        "lib/form.js",
        "lib/flow.js",
        "lib/core.js",
        "lib/page.js",
        "content/careers.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}